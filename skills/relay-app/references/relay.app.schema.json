{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relay app contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets"],
  "properties": {
    "version": { "const": 1 },
    "project": { "anyOf": [{ "const": "." }, { "$ref": "#/$defs/path" }] },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "windows-x86_64": { "$ref": "#/$defs/windows" },
        "windows-aarch64": { "$ref": "#/$defs/windows" },
        "macos-x86_64": { "$ref": "#/$defs/macos" },
        "macos-aarch64": { "$ref": "#/$defs/macos" }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string", "minLength": 1, "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\\\:\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$"
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["program"],
      "properties": {
        "program": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!-)(?!\\.\\.?$)[^/\\\\: \\u0000-\\u001f\\u007f-\\u009f]+$" },
            { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "^(?!-).*/" }] }
          ]
        },
        "args": {
          "type": "array", "maxItems": 256,
          "items": { "type": "string", "maxLength": 16384, "pattern": "^[^\\u0000]*$" }
        }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["steps", "output", "entry"],
      "properties": {
        "steps": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/step" } },
        "output": { "$ref": "#/$defs/path" },
        "entry": { "$ref": "#/$defs/path" }
      }
    },
    "windows": { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "entry": { "pattern": "\\.(exe|jar)$" } } }] },
    "macos": { "allOf": [{ "$ref": "#/$defs/target" }, { "properties": { "entry": { "pattern": "\\.(app|jar)$" } } }] }
  }
}
