{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "0.1.0",
  "identifier": "dev.relay.store",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "node scripts/prepare-node.mjs && npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Relay", "hiddenTitle": true, "width": 820, "height": 640, "minWidth": 640, "minHeight": 500, "backgroundColor": "#fafaf9", "center": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'", "capabilities": ["main"] }
  },
  "bundle": { "active": true, "targets": "all", "shortDescription": "Your GitHub apps, kept together.", "category": "Utility", "resources": { "toolchains/": "toolchains/" }, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "windows": { "nsis": { "installMode": "currentUser" } }, "macOS": { "minimumSystemVersion": "13.5" } }
}
